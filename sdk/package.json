{
  "name": "@spinframework/spin-code-sandbox",
  "version": "0.1.0",
  "description": "An extensible client for sandboxed code execution from a Spin application. Ships a Wasm code-interpreter backend; extensible to other backends.",
  "type": "module",
  "license": "Apache-2.0 WITH LLVM-exception",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spinframework/spin-code-sandbox.git",
    "directory": "sdk"
  },
  "homepage": "https://github.com/spinframework/spin-code-sandbox/tree/main/sdk#readme",
  "bugs": {
    "url": "https://github.com/spinframework/spin-code-sandbox/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./interpreter": {
      "types": "./dist/interpreter/index.d.ts",
      "default": "./dist/interpreter/index.js"
    },
    "./store": {
      "types": "./dist/store/index.d.ts",
      "default": "./dist/store/index.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "default": "./dist/tools.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "test:components": "node --test test/components.test.ts",
    "check": "npm run typecheck && npm run test",
    "prepack": "npm run build"
  },
  "keywords": [
    "spin",
    "webassembly",
    "sandbox",
    "code-interpreter",
    "agent",
    "tools"
  ],
  "devDependencies": {
    "typescript": "^5.7.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
